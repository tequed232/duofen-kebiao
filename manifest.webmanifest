{
  "name": "多分课表",
  "short_name": "多分",
  "description": "Material 3 Expressive 课表应用：四日课表、教材识别与上课提醒，数据全部保存在本机。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5FBF6",
  "theme_color": "#F5FBF6",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "orientation": "portrait"
}
