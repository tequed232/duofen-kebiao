{
  "name": "duofen-kebiao",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "description": "多分课表：Material 3 Expressive 风格的课表应用（四日课表 / 教材识别 / 上课提醒）",
  "scripts": {
    "icons": "node scripts/subset-icons.mjs",
    "dev": "vite",
    "build": "node scripts/subset-icons.mjs && node scripts/check-icons.mjs && vite build",
    "apk": "gradlew.bat assembleRelease",
    "check:images": "node scripts/check-image-cache.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:web-security": "node scripts/check-web-security.mjs",
    "apk:parity": "node scripts/check-apk-parity.mjs",
    "preview": "vite preview --port 4173",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "^2.5.0",
    "material-symbols": "^0.47.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fontkit": "^2.0.4",
    "playwright": "^1.63.0",
    "subset-font": "^2.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
